<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>at.gepardec.fachtracing</groupId>
  <artifactId>fachtracing-parent</artifactId>
  <version>0.1.0-rc.1</version>
  <packaging>pom</packaging>

  <modules>
    <module>fachtracing-api</module>
    <module>fachtracing-engine</module>
    <module>fachtracing-spring</module>
    <module>fachtracing-jakartaee</module>
    <module>fachtracing-storage-jdbc</module>
    <module>fachtracing-agent</module>
    <module>fachtracing-maven-plugin</module>
  </modules>

  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>

  <profiles>
    <profile>
      <id>self-tracing</id>
      <build>
        <plugins>
          <plugin>
            <groupId>at.gepardec.fachtracing</groupId>
            <artifactId>fachtracing-maven-plugin</artifactId>
            <version>${project.version}</version>
            <inherited>false</inherited>
            <configuration>
              <businessEntryPoints>
                <businessEntryPoint>
                  <owner>at.gepardec.fachtracing.business.BusinessGraphProjector</owner>
                  <method>classifyNode</method>
                  <parameterTypes>
                    <parameterType>at.gepardec.fachtracing.model.BusinessDecisionGraph.NodeKind</parameterType>
                    <parameterType>boolean</parameterType>
                    <parameterType>boolean</parameterType>
                    <parameterType>boolean</parameterType>
                    <parameterType>boolean</parameterType>
                  </parameterTypes>
                  <label>include exact node in business graph</label>
                </businessEntryPoint>
                <businessEntryPoint>
                  <owner>at.gepardec.fachtracing.analysis.AnalysisSourceSelector</owner>
                  <method>selectPlan</method>
                  <parameterTypes>
                    <parameterType>boolean</parameterType>
                    <parameterType>boolean</parameterType>
                  </parameterTypes>
                  <label>select source inputs for graph analysis</label>
                </businessEntryPoint>
              </businessEntryPoints>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
