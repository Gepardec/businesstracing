<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>at.gepardec.fachtracing</groupId>
    <artifactId>fachtracing-parent</artifactId>
    <version>0.1.0-rc.1</version>
  </parent>
  <artifactId>fachtracing-maven-plugin</artifactId>
  <packaging>maven-plugin</packaging>
  <description>Analyze annotated Maven projects and generate Fachtracing graph artifacts.</description>

  <dependencies>
    <dependency>
      <groupId>at.gepardec.fachtracing</groupId>
      <artifactId>fachtracing-engine</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>at.gepardec.fachtracing</groupId>
      <artifactId>fachtracing-spring</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>at.gepardec.fachtracing</groupId>
      <artifactId>fachtracing-jakartaee</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.apache.maven</groupId>
      <artifactId>maven-plugin-api</artifactId>
      <version>3.9.16</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.apache.maven</groupId>
      <artifactId>maven-core</artifactId>
      <version>3.9.16</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.apache.maven.plugin-tools</groupId>
      <artifactId>maven-plugin-annotations</artifactId>
      <version>3.15.2</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.codehaus.plexus</groupId>
      <artifactId>plexus-utils</artifactId>
      <version>3.6.1</version>
      <scope>provided</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-plugin-plugin</artifactId>
        <version>3.15.2</version>
        <configuration>
          <goalPrefix>fachtracing</goalPrefix>
          <requiredJavaVersion>21</requiredJavaVersion>
          <requiredMavenVersion>3.9.0</requiredMavenVersion>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
