@startuml
title customer eligibility
left to right direction
usecase "Start" as n1
diamond "age is below 24" as n2
diamond "location equals Vienna" as n3
usecase "Stop" as n4
n1 -[#2E7D32,thickness=3]-> n2 : next
n2 -[#2E7D32,thickness=3]-> n3 : true
n2 -[#9E9E9E,dashed]-> n4 : false; returns false
n3 -[#2E7D32,thickness=3]-> n4 : true; returns account active
n3 -[#9E9E9E,dashed]-> n4 : false; returns false
@enduml
