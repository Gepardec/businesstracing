{
  "version": 1,
  "decisionCategories": [
    {
      "category": "reference-application-isolation",
      "count": 2,
      "pattern": "Keep pinned brownfield knowledge in conformance artifacts; production gains only target-neutral construct support."
    },
    {
      "category": "runtime-correlation",
      "count": 9,
      "pattern": "Precompute opaque graph topology and developer-only probe plans, then retain only proven runtime edges and explicit gaps without Java details."
    },
    {
      "category": "multi-format-projection",
      "count": 1,
      "pattern": "Resolve graph semantics once and keep text formats as deterministic dependency-free projections."
    },
    {
      "category": "business-vocabulary-normalization",
      "count": 3,
      "pattern": "Preserve result-relevant optionality as absent/exists while stripping language- and persistence-specific vocabulary from business projections."
    },
    {
      "category": "build-tool-adapter",
      "count": 6,
      "pattern": "Let the build tool provide source roots, resolved classpaths, explicit module ownership, and repository settings, while the engine owns graph and provenance contracts."
    },
    {
      "category": "source-provenance",
      "count": 5,
      "pattern": "Keep source, module, and analysis-decision provenance outside business records, and verify files, binary fingerprints, and exact commit blobs before using external logic."
    },
    {
      "category": "release-gate-integrity",
      "count": 4,
      "pattern": "Separate fast cached feedback from clean release proof, preserve exact status, give required checks a bounded verified time budget, and print success only after every required sub-gate passes."
    },
    {
      "category": "static-effect-proof",
      "count": 4,
      "pattern": "Treat namespace support and purity as separate proofs; keep attributed state roots, merge reachable alias and callback definitions, and report an exact gap for unproved result-relevant effects."
    },
    {
      "category": "build-artifact-boundary",
      "count": 1,
      "pattern": "Track immutable reviewed oracle inputs, write reproducible conformance projections under the build-output directory, and guard against accidental recommits."
    },
    {
      "category": "source-context-labeling",
      "count": 2,
      "pattern": "Derive business labels from attributed symbols, inferred types, receivers, generic elements, mutation targets, and operand structure; do not add reference-application vocabulary to production."
    },
    {
      "category": "platform-operation-classification",
      "count": 1,
      "pattern": "Classify equivalent current and legacy platform namespaces at one boundary while unsupported application binary logic stays fail-closed."
    },
    {
      "category": "branch-integration",
      "count": 1,
      "pattern": "Merge concurrent analyzer work by semantic union and regenerate shared aggregate records from all completed specifications."
    },
    {
      "category": "static-relevance-audit",
      "count": 2,
      "pattern": "Bound relevance to sliced expressions and use-site definitions, keep only compatible escaping failures, and make included, excluded, and unresolved source decisions mutually consistent outside business output."
    },
    {
      "category": "external-library-boundary",
      "count": 3,
      "pattern": "Require an explicit exact-artifact trust declaration before excluding dependency mechanics. Preserve source-visible receiver controls, and keep unselected and direct binary decisions fail-closed."
    },
    {
      "category": "wire-contract-schema",
      "count": 1,
      "pattern": "Generate formal wire schemas in the engine, derive closed values from production Java enums, and let build-tool adapters publish the matching artifact."
    },
    {
      "category": "path-sensitive-definition-flow",
      "count": 1,
      "pattern": "Let control-flow state decide which definitions reach each use; keep callback call-site definitions separate from result-slice use-site definitions."
    }
  ],
