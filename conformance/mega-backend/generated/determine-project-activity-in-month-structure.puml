@startuml
title determine project activity in month
left to right direction
usecase "Start" as n1
rectangle "derive month start as month at day 1" as n2
rectangle "derive month end as month at end of month" as n3
rectangle "derive starts before month ends as not start date is after month end" as n4
rectangle "derive ends after month starts as end date is absent or not end date is before month start" as n5
diamond "starts before month ends and ends after month starts" as n6
usecase "Stop" as n7
n1 --> n2 : next
n2 --> n3 : next
n3 --> n4 : next
n4 --> n5 : next
n5 --> n6 : next
n6 --> n7 : returns whether starts before month ends and ends after month starts
@enduml
