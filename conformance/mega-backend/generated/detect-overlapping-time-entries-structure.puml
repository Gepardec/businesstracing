@startuml
title detect overlapping time entries
left to right direction
usecase "Start" as n1
diamond "entry one to time equals entry two from time" as n2
diamond "entry one from time equals entry two to time" as n3
usecase "Stop" as n4
diamond "entry one to time is before entry two from time" as n5
diamond "entry one from time is after entry two to time" as n6
n2 --> n3 : false
n1 --> n2 : next
n2 --> n4 : true; returns false
n3 --> n4 : true; returns false
n5 --> n6 : false
n3 --> n5 : false
n6 --> n4 : false; returns whether neither entry one to time is before entry two from time nor entry one from time is after entry two to time
n5 --> n4 : true; returns whether neither entry one to time is before entry two from time nor entry one from time is after entry two to time
n6 --> n4 : true; returns whether neither entry one to time is before entry two from time nor entry one from time is after entry two to time
@enduml
