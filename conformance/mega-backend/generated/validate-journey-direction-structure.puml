@startuml
title validate journey direction
left to right direction
usecase "Start" as n1
diamond "choose by current direction" as n2
diamond "either former direction equals to or former direction equals further" as n3
rectangle "set warning to back missing" as n4
rectangle "set former direction to current direction" as n5
diamond "either former direction is absent or former direction equals back" as n6
rectangle "set warning to to missing" as n7
diamond "former direction exists" as n8
rectangle "set former direction to current direction" as n9
rectangle "decision cannot continue" as n10
usecase "Stop" as n11
rectangle "evaluate is finished" as n12
diamond "former direction exists and former direction equals back" as n13
rectangle "evaluate is starting new journey" as n14
diamond "all of warning is absent and not is finished and either next direction is absent or is starting new journey next direction" as n15
rectangle "set former direction to absent" as n16
n1 --> n2 : next
n2 --> n3 : to
n3 --> n4 : true
n4 --> n5 : next
n3 --> n5 : false
n2 --> n6 : further or back
n6 --> n7 : true
n7 --> n8 : next
n6 --> n8 : false
n8 --> n9 : true
n2 --> n10 : default
n10 --> n11 : fails
n5 --> n12 : next
n9 --> n12 : next
n8 --> n12 : false
n12 --> n13 : next
n13 --> n14 : result
n14 --> n15 : result
n15 --> n16 : true
n16 --> n11 : returns back missing
n15 --> n11 : false; returns warning
@enduml
