rectangle "set former direction to current direction" as n6
diamond "former direction is absent" as n7
diamond "former direction equals back" as n8
rectangle "set warning to to missing" as n9
diamond "former direction exists" as n10
rectangle "set former direction to current direction" as n11
rectangle "decision cannot continue" as n12
