n9 --> n10 : next
n8 --> n10 : false
n10 --> n11 : true
n2 --> n12 : default
n12 --> n13 : fails
n6 --> n14 : next
n11 --> n14 : next
n10 --> n14 : false
n15 --> n16 : true
n14 --> n15 : next
n16 --> n17 : true
n15 --> n17 : false
n16 --> n17 : false
n18 --> n19 : true
n20 --> n21 : false
n19 --> n20 : true
n17 --> n18 : result
