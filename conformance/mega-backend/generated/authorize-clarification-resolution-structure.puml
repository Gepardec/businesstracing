@startuml
title authorize clarification resolution
left to right direction
usecase "Start" as n1
diamond "user equals created by" as n2
rectangle "evaluate is open" as n3
diamond "status equals open" as n4
diamond "is open and eligible project lead contains actor and not actor equals subject employee and not actor equals user" as n5
usecase "Stop" as n6
rectangle "evaluate is open" as n7
diamond "status equals open" as n8
rectangle "evaluate is involved" as n9
diamond "eligible project lead contains actor or all of subject employee exists and subject employee equals actor" as n10
diamond "is open and is involved actor and not actor equals created by" as n11
n1 --> n2 : next
n2 --> n3 : true
n3 --> n4 : next
n4 --> n5 : result
n5 --> n6 : returns whether is open and eligible project lead contains actor and not actor equals subject employee and not actor equals user
n2 --> n7 : false
n7 --> n8 : next
n8 --> n9 : result
n9 --> n10 : next
n10 --> n11 : result
n11 --> n6 : returns whether is open and is involved actor and not actor equals created by
@enduml
